# Backup runner only. Never add these values to frontend JavaScript or commit secrets.
MONGODB_URI=
MONGODB_DATABASE=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Explicit category-to-collection/field mappings; see backups/README.md.
BACKUP_SOURCES_JSON=
BACKUP_MANIFEST_COLLECTION=weekly_backup_manifests
# 0 disables retention. Weekly workflows never run retention, even if this changes.
BACKUP_RETENTION_DAYS=0
# Prefer Application Default Credentials from short-lived workload identity.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a file outside this repo,
# or provide authorized_user / service_account JSON in this environment variable.
GOOGLE_DRIVE_CREDENTIALS_JSON=
